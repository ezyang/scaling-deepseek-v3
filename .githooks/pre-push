#!/bin/sh
# Refuse to push main (the GitHub Pages deploy) with stale cache stamps.
# Hashes go stale freely between publishes (see scripts/stamp.mjs); fix with
#   node scripts/stamp.mjs --publish && git commit -am 'Restamp for publish'
# Enable once per clone: git config core.hooksPath .githooks
while read -r _ local_sha remote_ref _; do
  [ "$remote_ref" = refs/heads/main ] && [ "$local_sha" != 0000000000000000000000000000000000000000 ] || continue
  # check the commit being pushed, not the working tree
  tmp=$(mktemp -d) && trap 'rm -rf "$tmp"' EXIT
  git archive "$local_sha" | tar -x -C "$tmp" && node "$tmp/scripts/stamp.mjs" --publish --check || exit 1
done
